# Copy this file to .env and fill in real values. Never commit .env itself.

# Supabase (or any Postgres) connection string — Settings > Database > Connection string (URI)
DATABASE_URL=postgresql://postgres.xxxx:YOUR-PASSWORD@aws-0-xxxx.pooler.supabase.com:6543/postgres

# Optional: port the local Express server listens on (Render sets this automatically in production)
PORT=4000

# Password required (as Basic Auth) to view /admin API routes and the backend status page
ADMIN_PASSWORD=choose-a-strong-password

# --- Frontend (Vite) env vars — go in a root .env, read at build time ---

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web)
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com

# Kakao Developers > 앱 키 > JavaScript 키
VITE_KAKAO_JS_KEY=your-kakao-javascript-key
